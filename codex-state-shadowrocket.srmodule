#!name=Codex Sleep State Sugar (Shadowrocket)
#!desc=Capture a validated Codex turn-state, reuse it on GPT-6 Astra, and refresh it before expiry.
#!homepage=https://github.com/ewsun22/csss
#!author=ewsun22

[Script]
# Shadowrocket keeps VLESS/TUN and the active routing rules. The script does not
# use Surge policy-descriptor or a Surge panel. force_http defaults to 0.
codex-state-request = type=http-request,pattern=^https://(chatgpt\\.com/backend-api/codex|api\\.openai\\.com/v1)/responses(?:\\?|$),script-path=https://raw.githubusercontent.com/ewsun22/csss/main/codex-state-shadowrocket.js,script-update-interval=86400,timeout=30,argument=model=gpt-6-astra&blocks=10&ttl=3600&renew=600&cooldown=300&timeout=20&force_http=0
codex-state-response = type=http-response,pattern=^https://(chatgpt\\.com/backend-api/codex|api\\.openai\\.com/v1)/responses(?:\\?|$),script-path=https://raw.githubusercontent.com/ewsun22/csss/main/codex-state-shadowrocket.js,script-update-interval=86400,timeout=10,argument=model=gpt-6-astra&blocks=10&ttl=3600&renew=600&cooldown=300&timeout=20&force_http=0

[MITM]
hostname = %APPEND% chatgpt.com, api.openai.com
