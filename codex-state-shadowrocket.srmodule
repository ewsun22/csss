#!name=Codex Sleep State Sugar (Shadowrocket)
#!desc=Observe Codex state and notify on same-turn injection. Cross-turn probing requires explicit experimental mode.
#!homepage=https://github.com/ewsun22/csss
#!author=ewsun22

[Script]
# Shadowrocket keeps VLESS/TUN and the active routing rules. force_http defaults
# to 0. mode=turn preserves native state and never probes.
# Set mode=experimental in BOTH arguments only to opt in to cross-turn experiments.
# Request bodies are read for model detection; response bodies are not buffered.
codex-state-request = type=http-request,requires-body=true,pattern=^https://(chatgpt\.com/backend-api/codex|api\.openai\.com/v1)/responses(?:\?|$),script-path=https://raw.githubusercontent.com/ewsun22/csss/main/codex-state-shadowrocket.js,script-update-interval=86400,timeout=30,argument=mode=turn&model=gpt-6-astra&blocks=10&ttl=3600&renew=600&cooldown=300&timeout=20&force_http=0
codex-state-response = type=http-response,pattern=^https://(chatgpt\.com/backend-api/codex|api\.openai\.com/v1)/responses(?:\?|$),script-path=https://raw.githubusercontent.com/ewsun22/csss/main/codex-state-shadowrocket.js,script-update-interval=86400,timeout=10,argument=mode=turn&model=gpt-6-astra&blocks=10&ttl=3600&renew=600&cooldown=300&timeout=20&force_http=0

[MITM]
hostname = %APPEND% chatgpt.com, api.openai.com
