#!name=Codex Sleep State Sugar
#!desc=Capture a validated Codex turn-state, reuse it on GPT-6 Astra, and refresh it before expiry.
#!system=mac

[MITM]
hostname = %APPEND% chatgpt.com, api.openai.com

[Script]
# Keep policy empty for home/residential broadband. Surge's normal rules choose the route.
codex-state-panel = type=generic,script-path=https://raw.githubusercontent.com/tzf1003/csss/main/codex-state.js,script-update-interval=86400,timeout=5,engine=jsc,argument=model=gpt-6-astra&blocks=10&ttl=3600&renew=600&cooldown=300
codex-state-request = type=http-request,pattern=^https://(chatgpt\.com/backend-api/codex|api\.openai\.com/v1)/responses(?:\?|$),script-path=https://raw.githubusercontent.com/tzf1003/csss/main/codex-state.js,script-update-interval=86400,requires-body=false,timeout=30,engine=jsc,debug=true,argument=model=gpt-6-astra&blocks=10&ttl=3600&renew=600&cooldown=300&timeout=20&force_http=1
codex-state-response = type=http-response,pattern=^https://(chatgpt\.com/backend-api/codex|api\.openai\.com/v1)/responses(?:\?|$),script-path=https://raw.githubusercontent.com/tzf1003/csss/main/codex-state.js,script-update-interval=86400,requires-body=false,timeout=10,engine=jsc,debug=true,argument=model=gpt-6-astra&blocks=10&ttl=3600&renew=600&cooldown=300&timeout=20&force_http=1

[Panel]
Codex 292 状态 = title="Codex 292：等待采集",content="发送 GPT-6 请求后，这里会显示采集、复用和历史记录",style=info,script-name=codex-state-panel,update-interval=1
